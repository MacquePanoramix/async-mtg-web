rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped index for "My Games" and cleanup list references.
    match /users/{uid}/games/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /games_v3/{gameId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isHost() {
        return isSignedIn() && resource.data.hostId == request.auth.uid;
      }

      function hasPlayerIds(gameData) {
        return 'playerIds' in gameData && gameData.playerIds is list;
      }

      function isLegacyTwoPlayerMember(gameData, uid) {
        return gameData.players is list
          && (
            (gameData.players.size() > 0 && gameData.players[0].id == uid)
            || (gameData.players.size() > 1 && gameData.players[1].id == uid)
          );
      }

      function isGameMember(gameData, uid) {
        // playerIds is the authoritative membership field for new games.
        // The fixed players[0]/players[1] fallback is only for legacy two-player games.
        return hasPlayerIds(gameData)
          ? uid in gameData.playerIds
          : isLegacyTwoPlayerMember(gameData, uid);
      }

      function isPlayer() {
        return isSignedIn() && isGameMember(resource.data, request.auth.uid);
      }

      function isJoiningAsPlayer2() {
        let changed = request.resource.data.diff(resource.data).changedKeys();

        // Future 3-4 player joins need stricter mutation validation or a callable function.
        return isSignedIn()
          && resource.data.players is list
          && request.resource.data.players is list
          && resource.data.players.size() == 1
          && request.resource.data.players.size() == 2
          && request.resource.data.players[0] == resource.data.players[0]
          && request.resource.data.players[1].id == request.auth.uid
          && request.resource.data.playerIds is list
          && request.resource.data.playerIds.size() == 2
          && request.resource.data.playerIds[0] == resource.data.players[0].id
          && request.resource.data.playerIds[1] == request.auth.uid
          && request.resource.data.turnOrderPlayerIds is list
          && request.resource.data.turnOrderPlayerIds.size() == 2
          && request.resource.data.turnOrderPlayerIds[0] == resource.data.players[0].id
          && request.resource.data.turnOrderPlayerIds[1] == request.auth.uid
          && changed.hasOnly([
            'players',
            'playerIds',
            'turnOrderPlayerIds',
            'state',
            'undoStack',
            'updatedAt',
            'log'
          ]);
      }

      function isSpectator() {
        return isSignedIn()
          && resource.data.spectatorIds is list
          && resource.data.spectatorIds.hasAny([request.auth.uid]);
      }

      function isChatOnlyUpdate() {
        return request.resource.data.diff(resource.data).changedKeys().hasOnly(['log'])
          && resource.data.log is list
          && request.resource.data.log is list
          && request.resource.data.log.size() == resource.data.log.size() + 1
          && request.resource.data.log[request.resource.data.log.size() - 1].type == 'CHAT'
          && request.resource.data.log[request.resource.data.log.size() - 1].playerId == request.auth.uid;
      }

      function isSpectatorJoinUpdate() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['spectatorIds'])
          && resource.data.spectatorIds is list
          && request.resource.data.spectatorIds is list
          && request.resource.data.spectatorIds.size() == resource.data.spectatorIds.size() + 1
          && request.resource.data.spectatorIds.hasAll(resource.data.spectatorIds)
          && request.auth.uid in request.resource.data.spectatorIds
          && !(request.auth.uid in resource.data.spectatorIds);
      }

      function isProxyAutopassUpdate() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        let oldPriority = resource.data.priorityPlayerId;
        let oldAutopass = resource.data.autopass == null ? {} : resource.data.autopass;
        let oldCfg = oldPriority == null ? null : oldAutopass[oldPriority];
        let newLogSize = request.resource.data.log.size();
        let oldLogSize = resource.data.log.size();
        let last = request.resource.data.log[newLogSize - 1];

        return isPlayer()
          && oldPriority != null
          && oldCfg != null
          && oldCfg.mode is string
          && oldCfg.mode != 'off'
          && resource.data.log is list
          && request.resource.data.log is list
          && changed.hasOnly([
            'phase',
            'step',
            'turnNumber',
            'activePlayerIndex',
            'priorityIndex',
            'priorityPlayerId',
            'stack',
            'cards',
            'log',
            'autopass'
          ])
          && newLogSize == oldLogSize + 1
          && (last.type == 'AUTOPASS' || last.type == 'AUTOPASS_PROXY')
          && last.playerId == oldPriority
          && last.actorId == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn();

      allow update: if
        isPlayer()
        || isJoiningAsPlayer2()
        || isSpectatorJoinUpdate()
        || (isSpectator() && isChatOnlyUpdate())
        || isProxyAutopassUpdate();

      // Hosts may hard-delete their own game documents for old game cleanup.
      allow delete: if isHost();

      match /events/{eventId} {
        function parentGame() {
          return get(/databases/$(database)/documents/games_v3/$(gameId)).data;
        }

        function isHostOfParentGame() {
          return request.auth != null && parentGame().hostId == request.auth.uid;
        }

        function isPlayerOnThisGame() {
          return request.auth != null
            && isGameMember(parentGame(), request.auth.uid);
        }

        allow read: if request.auth != null;
        allow create: if isPlayerOnThisGame();
        allow update: if false;
        allow delete: if isHostOfParentGame();
      }
    }
  }
}
